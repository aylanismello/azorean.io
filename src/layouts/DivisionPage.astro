---
import Layout from './Layout.astro';
import Pictogram from '../components/Pictogram.astro';

export interface Props {
  /** Catalogue index, e.g. "01" */
  n: string;
  title: string;
  pict: 'studios' | 'sol' | 'sound';
  role: string;
  intro: string;
  description: string;
  /** Each focus area gets a numbered row in the spec table. */
  focus: readonly { text: string; tag: string }[];
  /** Two-line pull quote. */
  philosophy: readonly [string, string];
  closing: string;
  seoTitle?: string;
  seoDescription?: string;
}

const {
  n,
  title,
  pict,
  role,
  intro,
  description,
  focus,
  philosophy,
  closing,
  seoTitle,
  seoDescription,
} = Astro.props;
---

<Layout title={seoTitle ?? `${title} — Azorean Studios`} description={seoDescription ?? intro}>
  <article class="page">
    <!-- Masthead -->
    <header class="wrap head">
      <div class="head-meta">
        <span class="num idx">{n}</span>
        <span class="label label--ink">{role}</span>
      </div>
      <div class="head-title">
        <h1 class="display">{title}</h1>
        <Pictogram name={pict} class="head-pict" />
      </div>
    </header>

    <!-- Intro -->
    <section class="wrap intro-block">
      <p class="lede intro">{intro}</p>
      <p class="body">{description}</p>
    </section>

    <!-- Focus areas as a spec table -->
    <section class="wrap section" id="focus">
      <span class="label label--ink block-label">— focus areas</span>
      <ul class="spec">
        {
          focus.map((f, i) => (
            <li>
              <span class="spec-n">{String(i + 1).padStart(2, '0')}</span>
              <span class="spec-t">{f.text}</span>
              <span class="spec-v">{f.tag}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Pull quote -->
    <section class="deep band" id="philosophy">
      <div class="wrap">
        <span class="label label--ink">— philosophy</span>
        <p class="statement">
          {philosophy[0]}<br />{philosophy[1]}
        </p>
      </div>
    </section>

    <!-- Closing + whatever the page wants to add -->
    <section class="wrap section">
      <p class="body closing">{closing}</p>
      <slot />
    </section>
  </article>
</Layout>

<style>
  .page {
    padding-top: 3.5rem;
  }

  .head-meta {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--rule-strong);
  }

  .idx {
    font-size: 0.72rem;
    color: var(--mid);
    letter-spacing: 0.1em;
  }

  .head-title {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    padding: 1.5rem 0 2.5rem;
  }

  .head-title :global(.head-pict) {
    width: 78px;
    height: 78px;
    flex-shrink: 0;
    margin-bottom: 0.5rem;
  }

  .intro-block {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 3rem;
    padding-bottom: 4rem;
  }

  .intro {
    max-width: 20ch;
  }

  .section {
    padding: 4rem 0;
  }

  .block-label {
    display: block;
    margin-bottom: 1.25rem;
  }

  .band {
    padding: 6rem 0;
  }

  .statement {
    font-size: clamp(2rem, 6vw, 4.6rem);
    line-height: 0.95;
    letter-spacing: -0.045em;
    text-transform: lowercase;
    margin-top: 1.25rem;
  }

  .closing {
    max-width: 58ch;
  }

  @media (max-width: 820px) {
    .intro-block {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      padding-bottom: 2.5rem;
    }

    .intro {
      max-width: none;
    }

    .head-title :global(.head-pict) {
      width: 48px;
      height: 48px;
    }
  }
</style>
