---
// A One Thing document page — privacy, support. The marketing page's paper and type, one readable column.
import Base from './OneThingBase.astro';
import Footer from '../components/onething/Footer.astro';
import { URLS } from '../onething/config.js';

interface Props {
  title: string;
  description: string;
  label: string;
  lede?: string;
  updated?: string;
}
const { title, description, label, lede, updated } = Astro.props;
---

<Base title={`${title} — One Thing`} description={description}>
  <header class="doc-top">
    <div class="wrap doc-top__row">
      <a class="doc-top__home" href={URLS.home}>
        <img src="/onething/icon.png" width="28" height="28" alt="" />
        <span>One Thing</span>
      </a>
      <nav class="doc-top__nav mono">
        <a href={URLS.support}>Support</a>
        <a href={URLS.privacy}>Privacy</a>
      </nav>
    </div>
  </header>

  <main class="wrap doc">
    <p class="label">{label}</p>
    <h1 class="doc__title"><span class="bar">{title}</span></h1>
    {lede && <p class="lede doc__lede">{lede}</p>}
    {updated && <p class="mono doc__updated">Effective {updated}</p>}
    <article class="doc__body">
      <slot />
    </article>
  </main>

  <Footer />
</Base>

<style>
  .doc-top { border-bottom: 1px solid var(--line); }
  .doc-top__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1rem;
  }
  .doc-top__home {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 700;
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
  }
  .doc-top__home img { border-radius: 7px; }
  .doc-top__nav { display: flex; gap: 1.5rem; }
  .doc-top__nav a { color: var(--dim); }
  .doc-top__nav a:hover { color: var(--ink); }

  .doc { padding-block: clamp(3rem, 8vw, 5.5rem) clamp(4rem, 10vw, 7rem); max-width: 46rem; }
  .doc__title {
    margin-top: 1rem;
    font-size: clamp(2.6rem, 8vw, 4.25rem);
    line-height: 1;
  }
  .doc__title .bar { white-space: normal; transform: rotate(-0.6deg); }
  .doc__lede { margin-top: 1.5rem; }
  .doc__updated { margin-top: 1rem; color: var(--faint); }

  .doc__body { margin-top: 3rem; display: grid; gap: 1.1rem; color: var(--dim); line-height: 1.65; }
  .doc__body :global(h2) {
    margin-top: 1.6rem;
    color: var(--ink);
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.015em;
  }
  .doc__body :global(h3) { margin-top: 0.4rem; color: var(--ink); font-size: 1.05rem; font-weight: 650; }
  .doc__body :global(strong) { color: var(--ink); font-weight: 600; }
  .doc__body :global(ul) { display: grid; gap: 0.55rem; padding-left: 1.2rem; list-style: disc; }
  .doc__body :global(li::marker) { color: var(--blue-deep); }
  .doc__body :global(a) { color: var(--link); text-decoration: underline; text-underline-offset: 3px; }
  .doc__body :global(.card) {
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    padding: 1.5rem 1.6rem;
  }
  .doc__body :global(.facts) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 0.75rem;
  }
  .doc__body :global(.fact) {
    background: var(--wash);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    padding: 0.9rem 1.1rem;
  }
  .doc__body :global(.fact span) { display: block; font-family: var(--mono); font-size: 0.8125rem; color: var(--faint); }
  .doc__body :global(.fact b) { display: block; margin-top: 0.3rem; color: var(--ink); font-weight: 600; }
  .doc__body :global(details) { border-top: 1px solid var(--line); padding-block: 1rem; }
  .doc__body :global(details:last-of-type) { border-bottom: 1px solid var(--line); }
  .doc__body :global(summary) { cursor: pointer; color: var(--ink); font-weight: 600; list-style: none; }
  .doc__body :global(summary::-webkit-details-marker) { display: none; }
  .doc__body :global(summary::after) { content: '+'; float: right; color: var(--faint); font-family: var(--mono); }
  .doc__body :global(details[open] summary::after) { content: '–'; }
  .doc__body :global(details p) { margin-top: 0.7rem; }
</style>
