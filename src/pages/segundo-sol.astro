---
import DivisionPage from '../layouts/DivisionPage.astro';

const focus = [
  { text: 'Curating and releasing ambient, healing, and conscious music', tag: 'label' },
  { text: 'Organizing gatherings and immersive experiences', tag: 'events' },
  { text: 'Supporting conscious artists and receptive communities', tag: 'artists' },
  { text: 'Integrating healing modalities with musical experiences', tag: 'practice' },
] as const;
---

<DivisionPage
  n="02"
  title="segundo sol"
  pict="sol"
  role="label & collective"
  intro="A community-centered collective fostering intentional gatherings and conscious music experiences."
  description="We nurture authentic community through the healing power of music and intentional gathering, creating containers for meaningful artistic expression."
  focus={focus}
  philosophy={['music as medicine.', 'community as healing.']}
  closing="From intimate listening sessions to expansive experiences, we create spaces where people can be fully themselves and express their truth without judgment."
>
  <div class="roster">
    <span class="label label--ink roster-label">— on the roster</span>
    <a href="/fluindo" class="artist">
      <div>
        <h2 class="title-md">fluindo</h2>
        <p class="body artist-desc">
          Future bossa and global downtempo out of Los Angeles. Bossa nova,
          leftfield club, and organic rhythm, built from field recordings and
          generative processes.
        </p>
      </div>
      <span class="artist-cta num">electronic press kit &rarr;</span>
    </a>
  </div>
</DivisionPage>

<style>
  .roster {
    margin-top: 3.5rem;
  }

  .roster-label {
    display: block;
    margin-bottom: 1.25rem;
  }

  .artist {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2rem;
    align-items: center;
    border: 1px solid var(--rule-strong);
    padding: 2rem;
    transition: background 0.15s, color 0.15s;
  }

  .artist:hover {
    background: var(--ink);
    color: var(--paper);
  }

  .artist:hover .artist-desc {
    color: rgba(242, 241, 238, 0.7);
  }

  .artist-desc {
    margin-top: 0.6rem;
  }

  .artist-cta {
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  @media (max-width: 820px) {
    .artist {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }
</style>
