---
import SomiBase from '../../layouts/SomiBase.astro'
import DocHeader from '../../components/somi/DocHeader.astro'
import { CONTACT, COMPANY, APP, FACTS, p } from '../../somi/config.js'

const troubleshooting = [
  {
    q: 'A video will not play, or the screen stays black',
    a: 'Exercise videos stream from our servers, so this is almost always the connection. Check you have signal or Wi-Fi, then close SoMi fully (swipe up from the bottom of the screen and flick the app away) and reopen it. If it persists on a good connection, email us with your iPhone model and iOS version.',
  },
  {
    q: 'I cannot hear the guide, or the music is drowning it out',
    a: 'Voice and music have separate volume sliders. Tap the music note button on the home or setup screen to open them and set each independently. Also check your ringer switch and that the phone is not routed to another AirPlay device.',
  },
  {
    q: 'My session did not save',
    a: 'A flow is committed at the end, when you complete the closing check-in. Leaving partway through means there is nothing to record. If you did finish the check-out and it still is not showing, tell us roughly when it happened and we will look.',
  },
  {
    q: 'My streak looks wrong',
    a: 'The streak counts days on which you completed a flow, in your device’s time zone. Travelling across time zones can shift a day boundary. If the number still looks wrong to you, email us — we would genuinely like to know.',
  },
  {
    q: 'Sign in with Apple is not working',
    a: 'Make sure you are signed into iCloud in iOS Settings and that two-factor authentication is on, which Apple requires. If you previously revoked SoMi in Settings → your name → Sign-In & Security → Sign in with Apple, you may need to re-enable it there.',
  },
  {
    q: 'I forgot my password',
    a: 'Use the password reset option on the sign-in screen and a reset link will be sent to your registered email address. If you signed up with Apple you do not have a password with us at all — just use Sign in with Apple again.',
  },
  {
    q: 'The flow is too hard, too long, or not what I need',
    a: `Every composed flow is editable before you start it. You can swap any individual exercise, reroll the whole sequence, toggle the body scans, and set the duration anywhere from ${FACTS.minMinutes} to ${FACTS.maxMinutes} minutes. Mid-flow, you can skip a block you are not feeling.`,
  },
]
---

<SomiBase
  title="Support"
  variant="document"
  description="Help with the SoMi app, common fixes, and how to reach a human."
>
  <DocHeader
    eyebrow="Help"
    title="Support"
    lede="One person reads this inbox and answers it. There is no ticket system and no bot."
  />

  <div class="mx-auto max-w-3xl px-5 pb-28 pt-10 sm:px-8">
    <!-- Contact card -->
    <div class="glass rounded-3xl p-8">
      <p class="eyebrow">Get in touch</p>
      <a
        href={`mailto:${CONTACT.support}`}
        class="mt-4 block font-display text-[1.8rem] leading-tight tracking-[-0.01em] text-teal underline underline-offset-[6px] transition-colors hover:text-foam sm:text-[2.2rem]"
      >
        {CONTACT.support}
      </a>
      <p class="mt-5 text-[0.95rem] leading-relaxed text-mist">
        We aim to reply within two business days. To save a round trip, tell us
        your iPhone model, your iOS version, and what you were doing when it went
        wrong.
      </p>
    </div>

    <div class="mt-8 grid gap-4 sm:grid-cols-3">
      <div class="glass rounded-2xl px-5 py-4">
        <p class="text-xs uppercase tracking-[0.12em] text-mist/70">Platform</p>
        <p class="mt-1.5 text-[0.95rem] text-foam">{APP.platform}</p>
      </div>
      <div class="glass rounded-2xl px-5 py-4">
        <p class="text-xs uppercase tracking-[0.12em] text-mist/70">Requires</p>
        <p class="mt-1.5 text-[0.95rem] text-foam">{APP.minOS}</p>
      </div>
      <div class="glass rounded-2xl px-5 py-4">
        <p class="text-xs uppercase tracking-[0.12em] text-mist/70">Price</p>
        <p class="mt-1.5 text-[0.95rem] text-foam">{APP.price}</p>
      </div>
    </div>

    <!-- Troubleshooting -->
    <section class="mt-16">
      <h2 class="font-display text-[2rem] leading-tight tracking-[-0.02em] text-foam">
        Common fixes
      </h2>

      <div class="mt-8 divide-y divide-foam/10 border-y border-foam/10">
        {
          troubleshooting.map((t) => (
            <details class="group py-5">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-[1rem] font-medium text-foam [&::-webkit-details-marker]:hidden">
                {t.q}
                <svg
                  viewBox="0 0 20 20"
                  class="h-5 w-5 shrink-0 text-teal transition-transform group-open:rotate-45"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  aria-hidden="true"
                >
                  <path d="M10 4v12M4 10h12" />
                </svg>
              </summary>
              <p class="mt-3.5 pr-10 text-[0.95rem] leading-relaxed text-mist">
                {t.a}
              </p>
            </details>
          ))
        }
      </div>
    </section>

    <!-- Quick links -->
    <section class="mt-16">
      <h2 class="font-display text-[2rem] leading-tight tracking-[-0.02em] text-foam">
        Also useful
      </h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        <a
          href={p('/account-deletion')}
          class="glass block rounded-2xl p-6 transition-colors hover:border-foam/28"
        >
          <p class="text-[1rem] font-semibold text-foam">Delete your account</p>
          <p class="mt-2 text-[0.9rem] leading-relaxed text-mist">
            Remove your account and every check-in, tag and journal entry — from
            inside the app, in two taps.
          </p>
        </a>
        <a
          href={p('/disclaimer')}
          class="glass block rounded-2xl p-6 transition-colors hover:border-foam/28"
        >
          <p class="text-[1rem] font-semibold text-foam">Health disclaimer</p>
          <p class="mt-2 text-[0.9rem] leading-relaxed text-mist">
            Who should check with a professional first, what can come up, and
            when to stop.
          </p>
        </a>
        <a
          href={p('/privacy')}
          class="glass block rounded-2xl p-6 transition-colors hover:border-foam/28"
        >
          <p class="text-[1rem] font-semibold text-foam">Privacy Policy</p>
          <p class="mt-2 text-[0.9rem] leading-relaxed text-mist">
            Exactly what is collected, who processes it, and how to get a copy or
            have it erased.
          </p>
        </a>
        <a
          href={p('/terms')}
          class="glass block rounded-2xl p-6 transition-colors hover:border-foam/28"
        >
          <p class="text-[1rem] font-semibold text-foam">Terms of Use</p>
          <p class="mt-2 text-[0.9rem] leading-relaxed text-mist">
            The agreement covering your use of the app.
          </p>
        </a>
      </div>
    </section>

    <p class="mt-16 text-sm text-mist">
      SoMi is made by{' '}
      <a
        href={COMPANY.site}
        class="text-teal underline underline-offset-4 hover:text-foam"
        rel="noopener">{COMPANY.name}</a
      >, {COMPANY.addressLine}.
    </p>
  </div>
</SomiBase>
