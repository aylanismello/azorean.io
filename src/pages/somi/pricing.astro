---
/**
 * The pricing page. The homepage teases it with the same phone mock; this is
 * where the whole argument lives — what free actually includes, what Depth
 * adds, and what the paywall you will eventually meet in the app looks like.
 */
import SomiBase from '../../layouts/SomiBase.astro'
import Paywall from '../../components/somi/Paywall.astro'
import Compare from '../../components/somi/Compare.astro'
import Cta from '../../components/somi/Cta.astro'
import { PRICING, FACTS, CONTACT, p } from '../../somi/config.js'

const promises = [
  {
    title: 'Free is a whole practice.',
    body: `Check in, get a flow built for that state, move through it, check out. Full block library, full algorithm, ${FACTS.minMinutes}–${FACTS.maxMinutes} minutes, as many times a day as you want. No ads, no card, no thinned-out version.`,
  },
  {
    title: 'Depth is memory.',
    body: 'Every check-in and session you have ever logged, what the months add up to, and the conveniences that make a long practice easier to keep. It gets more valuable the longer you stay.',
  },
  {
    title: 'The trial waits for you.',
    body: PRICING.trial,
  },
]

const faqs = [
  {
    q: 'Do I have to pay to use SoMi?',
    a: 'No. The practice is free and stays free — SOS, the daily flow at full quality, unlimited check-ins and today’s insight are never behind a paywall. Depth is optional, and it buys memory and convenience, not the practice itself.',
  },
  {
    q: 'When does the free trial start?',
    a: `${PRICING.trial} You will not be charged during it, and you can cancel from your Apple ID settings at any point before it ends.`,
  },
  {
    q: 'How do I cancel?',
    a: 'Through the App Store, like any other subscription: Settings → your name → Subscriptions → SoMi → Cancel. We never handle your card, so there is nothing to email us about and nobody to talk you out of it.',
  },
  {
    q: 'What happens to my history if I stop paying?',
    a: PRICING.lapsed + ' Your check-ins, sessions and notes stay on your account exactly as they were. Resubscribe and the whole record comes back into focus.',
  },
  {
    q: 'Is there a lifetime option?',
    a: PRICING.noLifetime,
  },
  {
    q: 'Do you offer refunds?',
    a: 'Apple handles all billing and refunds for App Store subscriptions — request one at reportaproblem.apple.com. If something went wrong on our side, email us anyway and we will help you make the case.',
  },
]
---

<SomiBase
  title="Pricing"
  description="SoMi's practice is free forever. Depth adds your whole history, your patterns, offline downloads and the full Moments library, from $14.99 a month or $89.99 a year."
>
  <!-- ─────────────────────────── Hero ─────────────────────────── -->
  <section class="relative overflow-hidden">
    <div class="aurora pointer-events-none absolute inset-0 -z-10"></div>
    <div
      class="pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-64 bg-gradient-to-b from-transparent to-abyss"
    >
    </div>

    <div class="mx-auto max-w-6xl px-5 pb-24 pt-32 sm:px-8 sm:pt-40">
      <div class="grid items-center gap-16 lg:grid-cols-[1.05fr_0.95fr]">
        <div>
          <p class="eyebrow">Pricing</p>

          <h1
            class="mt-5 font-display text-[2.9rem] leading-[1.04] tracking-[-0.02em] text-foam sm:text-[4rem]"
          >
            Free gets you today.
            <span class="block italic text-teal">Depth gets you time.</span>
          </h1>

          <p class="mt-7 max-w-xl text-lg leading-relaxed text-mist">
            The practice costs nothing and always will. What you can pay for is
            the record it leaves behind — every check-in, every flow, and what
            they add up to over months.
          </p>

          <div class="mt-9">
            <Cta />
          </div>

          <p class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-1 text-sm text-mist">
            <span
              >Depth {PRICING.monthly}/mo · {PRICING.yearly}/yr · save {
                PRICING.yearlySaving
              }</span
            >
            <span aria-hidden="true" class="hidden text-foam/25 sm:inline">·</span>
            <span>Cancel anytime</span>
          </p>
        </div>

        <!-- The paywall you meet in the app, at actual proportions. -->
        <figure class="mx-auto w-full max-w-[20.5rem] sm:max-w-[21rem]">
          <Paywall />
          <figcaption class="mt-5 text-center text-[0.8rem] leading-relaxed text-mist">
            The Depth screen, exactly as it appears in the app.
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- ─────────────────────── Three promises ─────────────────────── -->
  <section class="border-y border-foam/8 bg-ocean/30">
    <div class="mx-auto max-w-6xl px-5 py-24 sm:px-8">
      <div class="grid gap-12 md:grid-cols-3 md:gap-10">
        {
          promises.map((item) => (
            <div>
              <h2 class="font-display text-[1.6rem] leading-tight tracking-[-0.01em] text-foam">
                {item.title}
              </h2>
              <p class="mt-4 text-[0.98rem] leading-relaxed text-mist">{item.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ─────────────────────── The comparison ─────────────────────── -->
  <section id="compare" class="mx-auto max-w-6xl scroll-mt-24 px-5 py-28 sm:px-8">
    <div class="max-w-2xl">
      <p class="eyebrow">Line by line</p>
      <h2
        class="mt-4 font-display text-[2.4rem] leading-[1.12] tracking-[-0.02em] text-foam sm:text-[3rem]"
      >
        Exactly what is free, and what is not.
      </h2>
      <p class="mt-5 text-[1.02rem] leading-relaxed text-mist">
        No asterisks. If a row is a dash in the free column, that is the honest
        answer — and if it is marked <span class="text-foam">Coming</span>, it is
        not in the app yet, whether or not you pay.
      </p>
    </div>

    <div class="mt-14">
      <Compare />
    </div>
  </section>

  <!-- ─────────────────────── Billing FAQ ─────────────────────── -->
  <section id="faq" class="border-y border-foam/8 bg-ocean/30">
    <div class="mx-auto max-w-3xl scroll-mt-24 px-5 py-28 sm:px-8">
      <p class="eyebrow">Billing</p>
      <h2
        class="mt-4 font-display text-[2.4rem] leading-[1.12] tracking-[-0.02em] text-foam sm:text-[3rem]"
      >
        The awkward questions.
      </h2>

      <div class="mt-12 divide-y divide-foam/10 border-y border-foam/10">
        {
          faqs.map((f) => (
            <details class="group py-5">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-[1.02rem] font-medium text-foam [&::-webkit-details-marker]:hidden">
                {f.q}
                <svg
                  viewBox="0 0 20 20"
                  class="h-5 w-5 shrink-0 text-teal transition-transform group-open:rotate-45"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  aria-hidden="true"
                >
                  <path d="M10 4v12M4 10h12" />
                </svg>
              </summary>
              <p class="mt-3.5 max-w-2xl pr-10 text-[0.98rem] leading-relaxed text-mist">
                {f.a}
              </p>
            </details>
          ))
        }
      </div>

      <p class="mt-8 text-[0.95rem] leading-relaxed text-mist">
        Still unsure?
        <a
          href={`mailto:${CONTACT.support}?subject=SoMi%20pricing`}
          class="text-teal underline underline-offset-4 hover:text-foam">Email us</a
        > — or read the <a
          href={p('/terms')}
          class="text-teal underline underline-offset-4 hover:text-foam">Terms of Use</a
        >, which say the same things in longer sentences.
      </p>
    </div>
  </section>

  <!-- ─────────────────────── Final CTA ─────────────────────── -->
  <section class="relative overflow-hidden">
    <div class="aurora pointer-events-none absolute inset-0 -z-10 opacity-70"></div>
    <div class="mx-auto max-w-3xl px-5 py-28 text-center sm:px-8">
      <h2
        class="font-display text-[2.6rem] leading-[1.08] tracking-[-0.02em] text-foam sm:text-[3.4rem]"
      >
        Start free. Stay free if you like.
      </h2>
      <p class="mx-auto mt-6 max-w-xl text-lg text-mist">
        Nothing about the practice is waiting behind a card.
      </p>
      <div class="mt-10">
        <Cta align="center" />
      </div>
    </div>
  </section>
</SomiBase>
