---
import Layout from '../layouts/Layout.astro';

const methods = [
  {
    n: '01',
    head: 'general',
    addr: 'hello@azorean.io',
    note: 'Best for project inquiries',
  },
  {
    n: '02',
    head: 'studio bookings',
    addr: 'studio@azorean.io',
    note: 'Recording & audio services',
  },
  {
    n: '03',
    head: 'community events',
    addr: 'events@segundosol.com',
    note: 'Gatherings & collaborations',
  },
];

const areas = [
  { text: 'Technology & apps', tag: 'studios' },
  { text: 'Music & audio', tag: 'sound' },
  { text: 'Events & community', tag: 'segundo sol' },
  { text: 'Studio recording', tag: 'sound' },
  { text: 'Other collaboration', tag: 'open' },
];
---

<Layout
  title="Contact — Azorean Studios"
  description="Start a project with Azorean Studios — technology, sound, and community collaboration."
>
  <article class="page">
    <header class="wrap head">
      <div class="head-meta">
        <span class="num idx">04</span>
        <span class="label label--ink">get in touch</span>
      </div>
      <h1 class="display head-title">let's create<br />together</h1>
      <p class="lede head-lede">
        Ready to explore the intersection of technology, sound, and
        consciousness? Tell us what you're imagining.
      </p>
    </header>

    <div class="wrap cols">
      <!-- Form -->
      <section class="form-col">
        <span class="label label--ink block-label">— start a conversation</span>

        <form id="contact-form" novalidate>
          <div class="field">
            <label for="name" class="label label--ink">name</label>
            <input type="text" id="name" name="name" required autocomplete="name" />
          </div>

          <div class="field">
            <label for="email" class="label label--ink">email</label>
            <input type="email" id="email" name="email" required autocomplete="email" />
          </div>

          <div class="field">
            <label for="project-type" class="label label--ink">project type</label>
            <select id="project-type" name="project-type" required>
              <option value="">select…</option>
              <option value="Technology &amp; Apps">technology &amp; apps</option>
              <option value="Music &amp; Audio">music &amp; audio</option>
              <option value="Events &amp; Community">events &amp; community</option>
              <option value="Studio Recording">studio recording</option>
              <option value="Other Collaboration">other collaboration</option>
            </select>
          </div>

          <div class="field">
            <label for="message" class="label label--ink">tell us about your vision</label>
            <textarea
              id="message"
              name="message"
              rows="7"
              required
              placeholder="Share your ideas, goals, and what you're hoping to create…"></textarea>
          </div>

          <button type="submit" class="btn btn--fill">
            send message
            <span aria-hidden="true">&rarr;</span>
          </button>

          <p class="form-note num">
            opens your mail app — nothing is stored on this site
          </p>
        </form>
      </section>

      <!-- Direct contact -->
      <aside class="info-col" id="connect">
        <span class="label label--ink block-label">— ways to connect</span>

        <ul class="methods">
          {
            methods.map((m) => (
              <li>
                <span class="num method-n">{m.n}</span>
                <div>
                  <span class="label label--ink">{m.head}</span>
                  <a href={`mailto:${m.addr}`} class="method-addr">
                    {m.addr}
                  </a>
                  <span class="method-note">{m.note}</span>
                </div>
              </li>
            ))
          }
        </ul>

        <div class="response">
          <span class="label label--ink">response time</span>
          <p class="body">
            We typically respond within 24–48 hours. For urgent studio bookings,
            please mention this in your message.
          </p>
        </div>
      </aside>
    </div>

    <!-- Collaboration areas -->
    <section class="wrap section">
      <span class="label label--ink block-label">— collaboration opportunities</span>
      <ul class="spec">
        {
          areas.map((a, i) => (
            <li>
              <span class="spec-n">{String(i + 1).padStart(2, '0')}</span>
              <span class="spec-t">{a.text}</span>
              <span class="spec-v">{a.tag}</span>
            </li>
          ))
        }
      </ul>
    </section>
  </article>
</Layout>

<style>
  .page {
    padding-top: 3.5rem;
  }

  .head-meta {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--rule-strong);
  }

  .idx {
    font-size: 0.72rem;
    color: var(--mid);
    letter-spacing: 0.1em;
  }

  .head-title {
    padding: 1.5rem 0 1.25rem;
  }

  .head-lede {
    max-width: 40ch;
    padding-bottom: 3.5rem;
  }

  .cols {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: 4rem;
    padding-bottom: 4rem;
  }

  .block-label {
    display: block;
    margin-bottom: 1.5rem;
  }

  /* Form */
  .field {
    margin-bottom: 1.5rem;
  }

  .field label {
    display: block;
    margin-bottom: 0.45rem;
  }

  input,
  select,
  textarea {
    width: 100%;
    font-family: var(--font);
    font-size: 1rem;
    color: var(--ink);
    background: transparent;
    border: 1px solid var(--rule-strong);
    border-radius: 0;
    padding: 0.7rem 0.85rem;
    transition: border-color 0.15s, box-shadow 0.15s;
    -webkit-appearance: none;
    appearance: none;
  }

  select {
    background-image: linear-gradient(45deg, transparent 50%, var(--ink) 50%),
      linear-gradient(135deg, var(--ink) 50%, transparent 50%);
    background-position: calc(100% - 18px) 55%, calc(100% - 13px) 55%;
    background-size: 5px 5px, 5px 5px;
    background-repeat: no-repeat;
    padding-right: 2.25rem;
  }

  textarea {
    resize: vertical;
    line-height: 1.55;
  }

  input:focus,
  select:focus,
  textarea:focus {
    outline: none;
    border-color: var(--mid);
    box-shadow: inset 0 0 0 1px var(--bright);
  }

  ::placeholder {
    color: var(--ink-45);
  }

  .form-note {
    margin-top: 0.9rem;
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-45);
  }

  /* Methods */
  .methods {
    list-style: none;
    border-top: 1px solid var(--rule-strong);
  }

  .methods li {
    display: grid;
    grid-template-columns: 2.4rem 1fr;
    gap: 1rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .method-n {
    font-size: 0.7rem;
    color: var(--mid);
  }

  .method-addr {
    display: block;
    margin-top: 0.3rem;
    font-size: 1.05rem;
    letter-spacing: -0.02em;
    border-bottom: 1px solid var(--ink);
    padding-bottom: 1px;
    width: fit-content;
    transition: color 0.15s, border-color 0.15s;
  }

  .method-addr:hover {
    color: var(--mid);
    border-color: var(--mid);
  }

  .method-note {
    display: block;
    margin-top: 0.35rem;
    font-size: 0.85rem;
    color: var(--ink-70);
  }

  .response {
    margin-top: 2.25rem;
  }

  .response .body {
    margin-top: 0.5rem;
    font-size: 0.92rem;
  }

  .section {
    padding: 4rem 0;
    border-top: 1px solid var(--rule-strong);
  }

  @media (max-width: 900px) {
    .cols {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }
</style>

<script>
  /*
   * No backend on this site, so the form composes a pre-filled email and hands
   * it to the visitor's mail client. Nothing is transmitted or stored here.
   */
  const form = document.getElementById('contact-form') as HTMLFormElement | null

  form?.addEventListener('submit', (event) => {
    event.preventDefault()

    if (!form.reportValidity()) return

    const data = new FormData(form)
    const name = String(data.get('name') ?? '').trim()
    const email = String(data.get('email') ?? '').trim()
    const type = String(data.get('project-type') ?? '').trim()
    const message = String(data.get('message') ?? '').trim()

    const subject = `${type || 'Project inquiry'} — ${name}`
    const body = [
      `Name: ${name}`,
      `Email: ${email}`,
      `Project type: ${type}`,
      '',
      message,
    ].join('\n')

    window.location.href =
      `mailto:hello@azorean.io?subject=${encodeURIComponent(subject)}` +
      `&body=${encodeURIComponent(body)}`
  })
</script>
