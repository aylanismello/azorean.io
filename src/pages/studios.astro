---
import DivisionPage from '../layouts/DivisionPage.astro';
import Pictogram from '../components/Pictogram.astro';

const focus = [
  { text: 'Somatic tools that encourage breath, awareness, and stillness', tag: 'somatic' },
  { text: 'Audio-based experiments that use generative sound or ambient environments', tag: 'audio' },
  { text: 'Interactive web projects inspired by nature, the ocean, and human rhythm', tag: 'web' },
] as const;
---

<DivisionPage
  n="01"
  title="studios"
  pict="studios"
  role="mindful digital tools"
  intro="We build tools at the intersection of wellness, sound, and embodiment."
  description="Small, intentional apps — often experimental — that explore how technology can support nervous system regulation, creative flow, and deeper presence."
  focus={focus}
  philosophy={["we don't chase scale.", 'we build for feeling.']}
  closing="Each project reflects a commitment to slowness, simplicity, and intuitive design — shaped by our roots in creative coding, music, and embodied experience."
>
  <a href="/somi" class="product">
    <Pictogram name="somi" />
    <div class="product-body">
      <span class="badge">now building</span>
      <h2 class="title-md product-title">somi</h2>
      <p class="body product-desc">
        Short somatic flows for iPhone, composed around how your nervous system
        actually feels today. Check in, move, check out.
      </p>
      <ul class="product-spec">
        <li><span class="num">platform</span><span class="num">iphone</span></li>
        <li><span class="num">sessions</span><span class="num">5–18 min</span></li>
        <li><span class="num">price</span><span class="num">free</span></li>
        <li><span class="num">status</span><span class="num orange">pre-release</span></li>
      </ul>
    </div>
    <span class="product-cta num">see the app &rarr;</span>
  </a>
</DivisionPage>

<style>
  .product {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 2rem;
    align-items: start;
    border: 1px solid var(--rule-strong);
    padding: 2rem;
    margin-top: 3rem;
    transition: background 0.15s, color 0.15s;
  }

  .product:hover {
    background: var(--ink);
    color: var(--paper);
  }

  .product:hover :global(.pict) {
    fill: var(--paper);
  }

  .product:hover .product-desc {
    color: rgba(242, 241, 238, 0.7);
  }

  .product:hover .product-spec li {
    border-color: rgba(242, 241, 238, 0.25);
  }

  .product-title {
    margin: 0.7rem 0 0.5rem;
  }

  .product-spec {
    list-style: none;
    margin-top: 1.5rem;
    max-width: 24rem;
  }

  .product-spec li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.4rem 0;
    border-bottom: 1px solid var(--rule);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .product-spec .orange {
    color: var(--mid);
  }

  .product-cta {
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  @media (max-width: 820px) {
    .product {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }
</style>
