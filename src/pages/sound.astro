---
import DivisionPage from '../layouts/DivisionPage.astro';

const focus = [
  { text: 'Ambient production and meditative audio experiences', tag: 'ambient' },
  { text: 'Sound design for digital experiences and installations', tag: 'design' },
  { text: 'Music scoring for film and therapeutic applications', tag: 'scoring' },
  { text: 'Experimental audio research and conscious sound creation', tag: 'research' },
] as const;
---

<DivisionPage
  n="03"
  title="sound"
  pict="sound"
  role="modular audio lab"
  intro="A modular experimental sound engine crafting ambient soundscapes and audio experiences."
  description="We specialize in creating immersive soundscapes that transport listeners into states of deep presence and contemplation."
  focus={focus}
  philosophy={['every sound is intentional.', 'every frequency serves presence.']}
  closing="Our modular approach combines vintage analog warmth with cutting-edge digital precision, creating a sonic palette that bridges the organic and the electronic."
>
  <div class="signal">
    <span class="label label--ink signal-label">— signal chain</span>
    <ul class="spec">
      <li>
        <span class="spec-n">in</span>
        <span class="spec-t">Field recordings, acoustic sources, modular voltage</span>
        <span class="spec-v">capture</span>
      </li>
      <li>
        <span class="spec-n">proc</span>
        <span class="spec-t">Analog colour, granular and generative processing</span>
        <span class="spec-v">shape</span>
      </li>
      <li>
        <span class="spec-n">out</span>
        <span class="spec-t">Records, scores, installations, and app soundtracks</span>
        <span class="spec-v">release</span>
      </li>
    </ul>

    <a href="mailto:studio@azorean.io" class="btn signal-cta">
      studio bookings
      <span aria-hidden="true">&rarr;</span>
    </a>
  </div>
</DivisionPage>

<style>
  .signal {
    margin-top: 3.5rem;
  }

  .signal-label {
    display: block;
    margin-bottom: 1.25rem;
  }

  .signal-cta {
    margin-top: 2rem;
  }
</style>
