---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Pictogram from '../components/Pictogram.astro';

const divisions = [
  {
    n: '01',
    pict: 'studios',
    name: 'studios',
    role: 'mindful digital tools',
    body: 'The technological heart of the ecosystem — small, intentional apps that explore how software can support nervous system regulation, creative flow, and deeper presence.',
    href: '/studios',
    cta: 'explore technology',
    meta: ['ios', 'web', 'experimental'],
  },
  {
    n: '02',
    pict: 'sol',
    name: 'segundo sol',
    role: 'label & collective',
    body: 'A community-focused collective fostering intentional gatherings, conscious music releases, and collaborative experiences. Music as medicine, community as healing.',
    href: '/segundo-sol',
    cta: 'join community',
    meta: ['releases', 'events', 'artists'],
  },
  {
    n: '03',
    pict: 'sound',
    name: 'sound',
    role: 'modular audio lab',
    body: 'A modular experimental sound engine crafting ambient soundscapes, field recordings, and compositions for film, installation, and therapeutic use.',
    href: '/sound',
    cta: 'enter studio',
    meta: ['ambient', 'scoring', 'design'],
  },
] as const;
---

<Layout title="Azorean Studios — a studio for slow tech, sound, and story">
  <Hero />

  <!-- ── Divisions index ──────────────────────────────────────────────── -->
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <span class="label label--ink">— divisions</span>
        <h2 class="title-lg">three ways in</h2>
      </div>

      <div class="grid">
        {
          divisions.map((d) => (
            <article class="unit">
              <div class="unit-top">
                <span class="num unit-n">{d.n}</span>
                <Pictogram name={d.pict} />
              </div>

              <h3 class="unit-name">{d.name}</h3>
              <span class="label unit-role">{d.role}</span>
              <p class="unit-body">{d.body}</p>

              <ul class="chips">
                {d.meta.map((m) => (
                  <li class="chip">{m}</li>
                ))}
              </ul>

              <a href={d.href} class="btn unit-cta">
                {d.cta}
                <span aria-hidden="true">&rarr;</span>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ── About ────────────────────────────────────────────────────────── -->
  <section class="section band">
    <div class="wrap two-col">
      <div>
        <span class="label label--ink">— about</span>
        <h2 class="title-lg about-h">bridging worlds through mindful technology</h2>
      </div>
      <div class="col-text">
        <p class="lede">
          From the volcanic landscapes of São Miguel to the depths of digital
          innovation, we create experiences that connect the physical and
          virtual.
        </p>
        <p class="body">
          Our three creative divisions explore sound, community, and
          technological innovation as pathways to deeper human connection.
        </p>
      </div>
    </div>
  </section>

  <!-- ── Philosophy — the descent ─────────────────────────────────────── -->
  <section class="deep philosophy">
    <div class="wrap">
      <span class="label label--ink">— philosophy</span>
      <p class="statement">rooted in presence,<br />reaching for wonder.</p>

      <div class="two-col philo">
        <p class="body">
          Like the volcanic islands emerging from the Atlantic depths, we
          believe the most profound innovations arise from patience, presence,
          and respect for natural rhythms.
        </p>
        <p class="body">
          Every project we undertake honors the balance between technological
          possibility and human flourishing, creating tools that invite deeper
          connection rather than distraction.
        </p>
      </div>
    </div>
  </section>

  <!-- ── Now building ─────────────────────────────────────────────────── -->
  <section class="section">
    <div class="wrap">
      <a href="/somi" class="now">
        <Pictogram name="somi" />
        <div>
          <span class="badge">now building</span>
          <h2 class="title-md now-title">somi — somatic practice for iphone</h2>
          <p class="body now-body">
            Check in with how your body actually feels, get a short flow of
            body-based exercises built for that state, then check in again.
          </p>
        </div>
        <span class="now-cta num">see the app &rarr;</span>
      </a>
    </div>
  </section>
</Layout>

<style>
  .section {
    padding: 5rem 0;
  }

  .band {
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    background: var(--paper-2);
  }

  .philosophy {
    padding: 7rem 0;
  }

  .section-head {
    border-bottom: 1px solid var(--rule-strong);
    padding-bottom: 1.25rem;
    margin-bottom: 2.5rem;
  }

  .section-head .label {
    display: block;
    margin-bottom: 0.6rem;
  }

  /* Divisions */
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }

  .unit {
    display: flex;
    flex-direction: column;
    padding-right: 2rem;
    border-right: 1px solid var(--rule);
  }

  .unit + .unit {
    padding-left: 2rem;
  }

  .unit:last-child {
    border-right: 0;
    padding-right: 0;
  }

  .unit-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }

  .unit-n {
    font-size: 0.72rem;
    color: var(--mid);
    letter-spacing: 0.1em;
  }

  .unit-name {
    font-size: clamp(1.5rem, 2.6vw, 2.1rem);
    letter-spacing: -0.04em;
  }

  .unit-role {
    display: block;
    margin-top: 0.3rem;
  }

  .unit-body {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--ink-70);
    margin-top: 1rem;
  }

  .chips {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 1.25rem 0 1.75rem;
  }

  .chip {
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border: 1px solid var(--rule);
    padding: 0.22rem 0.5rem;
    color: var(--ink-70);
  }

  .unit-cta {
    margin-top: auto;
    align-self: flex-start;
  }

  /* Two column */
  .two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
  }

  .about-h {
    margin-top: 0.6rem;
    max-width: 14ch;
  }

  .col-text > * + * {
    margin-top: 1.25rem;
  }

  /* Philosophy */
  .statement {
    font-size: clamp(2.2rem, 6.5vw, 5rem);
    line-height: 0.95;
    letter-spacing: -0.045em;
    text-transform: lowercase;
    margin: 1.25rem 0 3rem;
  }

  .philo {
    border-top: 1px solid var(--on-deep-rule);
    padding-top: 2rem;
  }

  /* Now building */
  .now {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 2rem;
    align-items: center;
    border: 1px solid var(--rule);
    background: linear-gradient(
      100deg,
      rgba(202, 240, 248, 0.5) 0%,
      rgba(246, 251, 253, 0.4) 60%
    );
    padding: 2rem;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }

  .now:hover {
    background: linear-gradient(100deg, var(--deep) 0%, var(--abyss) 90%);
    border-color: var(--deep);
    color: var(--on-deep);
  }

  .now:hover :global(.pict) {
    fill: var(--mist);
  }

  .now:hover :global(.pict-accent) {
    fill: var(--glass);
  }

  .now:hover .now-body {
    color: var(--on-deep-70);
  }

  .now-title {
    margin: 0.7rem 0 0.5rem;
  }

  .now-cta {
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }

    .unit {
      border-right: 0;
      border-bottom: 1px solid var(--rule);
      padding: 2rem 0;
    }

    .unit + .unit {
      padding-left: 0;
    }

    .unit:first-child {
      padding-top: 0;
    }

    .two-col {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }

    .now {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }
</style>
