---
import Shot from './Shot.astro';
---

<header class="hero">
  <nav class="wrap hero__nav" aria-label="Primary">
    <a href="/mise" class="hero__brand" aria-label="Mise">
      <svg viewBox="0 0 64 64" width="22" height="22" aria-hidden="true">
        <rect width="64" height="64" rx="14" fill="var(--ink)"/>
        <g fill="var(--ground)">
          <rect x="10" y="28" width="4" height="8" rx="2"/>
          <rect x="18" y="20" width="4" height="24" rx="2"/>
          <rect x="26" y="12" width="4" height="40" rx="2"/>
          <rect x="34" y="22" width="4" height="20" rx="2"/>
          <rect x="42" y="16" width="4" height="32" rx="2"/>
          <rect x="50" y="26" width="4" height="12" rx="2"/>
        </g>
      </svg>
      <span>Mise</span>
    </a>
    <ul class="hero__links mono">
      <li><a href="#connect">Connect</a></li>
      <li><a href="#prep">Prep</a></li>
      <li><a href="#cook">Cook</a></li>
      <li><a href="#faq">FAQ</a></li>
    </ul>
  </nav>

  <div class="wrap hero__body">
    <p class="label">Sound library · Mac · iPhone · iPad</p>
    <h1 class="display">Mise</h1>
    <p class="hero__pitch lede">
      Mise puts all your sounds in one place, helps you find and prep the good ones,
      then lets you use them anywhere.
    </p>
    <p class="hero__sub body">
      Native on Mac, iPhone and iPad. Your library lives in iCloud; nothing is uploaded to us.
    </p>
    <div class="hero__cta">
      <a class="btn btn--limao" href="#">Get Mise for Mac</a>
      <a class="btn btn--ghost" href="#">TestFlight for iPhone &amp; iPad</a>
    </div>
  </div>

  <div class="wrap hero__shots">
    <Shot src="/mise/shots/mac-library.png" kind="mac" alt="The Mise library on Mac: a list of sounds with one row of chips, a waveform and the family of each sound." caption="mac-library.png" class="hero__mac" />
    <Shot src="/mise/shots/ios-library.png" kind="phone" alt="The Mise library on iPhone: the same sounds, the same chip row, the tape at the bottom." caption="ios-library.png" class="hero__phone" />
  </div>
</header>

<style>
  .hero {
    padding-top: 1.25rem;
    padding-bottom: clamp(4rem, 10vw, 8rem);
    border-bottom: 1px solid var(--line);
  }
  .hero__nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.75rem;
  }
  .hero__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    font-size: 1.0625rem;
  }
  .hero__links {
    display: flex;
    gap: clamp(1rem, 3vw, 2rem);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .hero__links a { color: var(--dim); }
  .hero__links a:hover { color: var(--ink); }

  .hero__body {
    padding-top: clamp(4rem, 12vw, 9rem);
    display: grid;
    gap: 1.5rem;
  }
  .hero__pitch {
    max-width: 40rem;
    margin-top: 0.5rem;
    color: var(--ink);
  }
  .hero__sub { max-width: 34rem; }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }

  .hero__shots {
    margin-top: clamp(3rem, 8vw, 6rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.26fr);
    align-items: end;
    gap: clamp(1rem, 3vw, 2rem);
  }
  @media (max-width: 720px) {
    .hero__shots { grid-template-columns: 1fr; }
    .hero__phone { max-width: 14rem; }
    .hero__links li:nth-child(n+3) { display: none; }
  }
  @media (max-width: 420px) {
    .hero__links { display: none; }
  }
</style>
