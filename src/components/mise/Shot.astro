---
/**
 * A screenshot slot. Renders the real image when it exists; when it does not,
 * the box stays — a panel in the theme with a mono caption — so the page
 * reads as finished before the PNGs land.
 */
interface Props {
  src: string;            // "/shots/mac-library.png"
  alt: string;
  kind?: 'mac' | 'phone' | 'ipad';
  caption?: string;
  class?: string;
}
const { src, alt, kind = 'mac', caption, class: cls = '' } = Astro.props;
const label = caption ?? src.split('/').pop();
---

<figure class={`shot shot--${kind} ${cls}`}>
  <div class="shot__frame">
    <img src={src} alt={alt} loading="lazy" decoding="async" onerror="this.parentElement.classList.add('missing')" />
    <div class="shot__ph" aria-hidden="true">
      <svg viewBox="0 0 120 32" class="shot__wave" preserveAspectRatio="none">
        <g fill="currentColor">
          <rect x="4"   y="12" width="3" height="8"  rx="1.5"/>
          <rect x="12"  y="8"  width="3" height="16" rx="1.5"/>
          <rect x="20"  y="4"  width="3" height="24" rx="1.5"/>
          <rect x="28"  y="10" width="3" height="12" rx="1.5"/>
          <rect x="36"  y="6"  width="3" height="20" rx="1.5"/>
          <rect x="44"  y="13" width="3" height="6"  rx="1.5"/>
          <rect x="52"  y="9"  width="3" height="14" rx="1.5"/>
          <rect x="60"  y="2"  width="3" height="28" rx="1.5"/>
          <rect x="68"  y="11" width="3" height="10" rx="1.5"/>
          <rect x="76"  y="7"  width="3" height="18" rx="1.5"/>
          <rect x="84"  y="12" width="3" height="8"  rx="1.5"/>
          <rect x="92"  y="5"  width="3" height="22" rx="1.5"/>
          <rect x="100" y="10" width="3" height="12" rx="1.5"/>
          <rect x="108" y="13" width="3" height="6"  rx="1.5"/>
        </g>
      </svg>
      <span class="shot__name">{label}</span>
    </div>
  </div>
</figure>

<style>
  .shot { width: 100%; }
  .shot__frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    overflow: hidden;
    box-shadow: 0 1px 0 var(--wash) inset, 0 30px 60px -30px rgba(0, 0, 0, 0.5);
  }
  .shot--phone .shot__frame {
    aspect-ratio: 9 / 19.5;
    border-radius: var(--r-xl);
  }
  .shot--ipad .shot__frame {
    aspect-ratio: 4 / 3;
    border-radius: var(--r-lg);
  }
  .shot__frame img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .shot__ph {
    position: absolute;
    inset: 0;
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 1.5rem;
    background:
      radial-gradient(60% 50% at 50% 100%, var(--wash) 0%, transparent 100%),
      var(--panel);
    color: var(--faint);
  }
  .shot__frame.missing img { display: none; }
  .shot__frame.missing .shot__ph { display: flex; }
  .shot__wave {
    width: clamp(6rem, 30%, 12rem);
    height: 2rem;
    color: var(--limao);
    opacity: 0.55;
  }
  .shot__name {
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    color: var(--faint);
  }
</style>
