---
interface Props {
  class?: string
}
const { class: className = '' } = Astro.props as Props
---

<span class={`inline-flex items-center gap-2.5 ${className}`}>
  <svg
    viewBox="0 0 32 32"
    aria-hidden="true"
    class="h-7 w-7 shrink-0"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <circle cx="16" cy="16" r="15" stroke="url(#somi-ring)" stroke-width="1.6" />
    <path
      d="M5.5 19.2c2.6-3.4 4.7-3.4 7 0 2.3 3.4 4.4 3.4 7 0 2.3-3 4.3-3.3 6.6-.9"
      stroke="url(#somi-wave)"
      stroke-width="1.9"
      stroke-linecap="round"
    />
    <path
      d="M6.5 13.1c2.4-3.1 4.3-3.1 6.4 0 2.1 3.1 4 3.1 6.4 0 2.1-2.8 3.9-3 6-.8"
      stroke="url(#somi-wave)"
      stroke-width="1.5"
      stroke-linecap="round"
      opacity="0.45"
    />
    <defs>
      <linearGradient id="somi-ring" x1="0" y1="0" x2="32" y2="32">
        <stop stop-color="#2dd4a8" />
        <stop offset="1" stop-color="#4fc3d9" stop-opacity="0.5" />
      </linearGradient>
      <linearGradient id="somi-wave" x1="4" y1="16" x2="28" y2="16">
        <stop stop-color="#2dd4a8" />
        <stop offset="1" stop-color="#4fc3d9" />
      </linearGradient>
    </defs>
  </svg>
  <span class="text-[1.05rem] font-semibold tracking-[0.02em] text-foam">SoMi</span>
</span>
