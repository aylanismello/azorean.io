---
import Wordmark from './Wordmark.astro'
import { NAV, APP, p } from '../../somi/config.js'
---

<header
  class="fixed inset-x-0 top-0 z-40 border-b border-foam/8 bg-abyss md:bg-abyss/70 md:backdrop-blur-xl"
>
  <nav
    aria-label="Primary"
    class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5 sm:px-8"
  >
    <a href={p('/')} class="shrink-0" aria-label="SoMi home">
      <Wordmark />
    </a>

    <div class="hidden items-center gap-8 md:flex">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            class="text-sm text-mist transition-colors hover:text-foam"
          >
            {item.label}
          </a>
        ))
      }
      {
        APP.appStoreUrl && (
          <a
            href={APP.appStoreUrl}
            class="rounded-full bg-teal px-4 py-2 text-sm font-semibold text-abyss transition-opacity hover:opacity-90"
          >
            Get SoMi
          </a>
        )
      }
    </div>

    <!-- Full-screen mobile navigation, built as a native disclosure with no JS. -->
    <details class="mobile-menu group relative md:hidden">
      <summary
        class="relative z-[60] flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-full border border-foam/15 text-foam transition-colors group-open:hidden [&::-webkit-details-marker]:hidden"
        aria-label="Toggle menu"
      >
        <svg
          viewBox="0 0 24 24"
          class="h-6 w-6"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M4 7h16M4 12h16M4 17h16" class="group-open:hidden" />
          <path d="M5 5l14 14M19 5L5 19" class="hidden group-open:block" />
        </svg>
      </summary>

      <div
        class="mobile-menu-panel fixed inset-0 z-50 flex min-h-dvh flex-col overflow-y-auto bg-abyss px-7 pt-5 pb-[max(2rem,env(safe-area-inset-bottom))]"
      >
        <div class="pointer-events-none absolute inset-0 aurora opacity-70"></div>
        <button
          type="button"
          class="relative z-10 ml-auto flex h-11 w-11 shrink-0 items-center justify-center text-[2.5rem] leading-none font-light text-foam"
          aria-label="Close menu"
          data-menu-close
        >
          <span aria-hidden="true">×</span>
        </button>

        <div class="relative mt-10 flex flex-1 flex-col">
          <div class="flex flex-col gap-1">
            <a
              href={p('/')}
              class="rounded-xl py-3 text-[clamp(1.9rem,9vw,2.65rem)] leading-tight font-semibold tracking-[-0.035em] text-foam"
            >
              Home
            </a>
            {
              NAV.map((item) => (
                <a
                  href={item.href}
                  class="rounded-xl py-3 text-[clamp(1.9rem,9vw,2.65rem)] leading-tight font-semibold tracking-[-0.035em] text-foam transition-colors hover:text-teal"
                >
                  {item.label}
                </a>
              ))
            }
          </div>

          <div class="mt-auto pt-14">
            {
              APP.appStoreUrl && (
                <a
                  href={APP.appStoreUrl}
                  class="mb-8 block w-full rounded-2xl bg-teal px-5 py-4 text-center text-base font-semibold text-abyss"
                >
                  Get SoMi
                </a>
              )
            }
            <div class="flex flex-wrap gap-x-7 gap-y-3 border-t border-foam/12 pt-6 text-sm font-medium text-mist">
              <a href={p('/privacy')} class="transition-colors hover:text-foam">Privacy</a>
              <a href={p('/terms')} class="transition-colors hover:text-foam">Terms</a>
              <a href={p('/disclaimer')} class="transition-colors hover:text-foam">Health disclaimer</a>
            </div>
          </div>
        </div>
      </div>
    </details>
  </nav>
</header>

<script>
  const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu')

  if (menu) {
    const trigger = menu.querySelector<HTMLElement>('summary')
    const closeButton = menu.querySelector<HTMLElement>('[data-menu-close]')

    menu.addEventListener('toggle', () => {
      if (menu.open) closeButton?.focus()
    })

    closeButton?.addEventListener('click', () => {
      menu.removeAttribute('open')
      trigger?.focus()
    })

    menu.querySelectorAll('.mobile-menu-panel a').forEach((link) => {
      link.addEventListener('click', () => menu.removeAttribute('open'))
    })

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') menu.removeAttribute('open')
    })
  }
</script>

<style is:global>
  html:has(.mobile-menu[open]) {
    overflow: hidden;
  }


  .mobile-menu[open] .mobile-menu-panel {
    animation: somi-menu-in 220ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }


  @keyframes somi-menu-in {
    from {
      opacity: 0;
      transform: translateY(-0.75rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-menu[open] .mobile-menu-panel {
      animation: none;
    }
  }
</style>
