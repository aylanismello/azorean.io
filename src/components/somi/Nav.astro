---
import Wordmark from './Wordmark.astro'
import { NAV, APP, p } from '../../somi/config.js'
---

<header
  class="fixed inset-x-0 top-0 z-40 border-b border-foam/8 bg-abyss md:bg-abyss/70 md:backdrop-blur-xl"
>
  <nav
    aria-label="Primary"
    class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5 sm:px-8"
  >
    <a href={p('/')} class="shrink-0" aria-label="SoMi home">
      <Wordmark />
    </a>

    <div class="hidden items-center gap-8 md:flex">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            class="text-sm text-mist transition-colors hover:text-foam"
          >
            {item.label}
          </a>
        ))
      }
      {
        APP.appStoreUrl && (
          <a
            href={APP.appStoreUrl}
            class="rounded-full bg-teal px-4 py-2 text-sm font-semibold text-abyss transition-opacity hover:opacity-90"
          >
            Get SoMi
          </a>
        )
      }
    </div>

    <!-- Mobile menu: <details> gives us a working disclosure with no JS. -->
    <details class="group relative md:hidden">
      <summary
        class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-full border border-foam/15 text-foam [&::-webkit-details-marker]:hidden"
        aria-label="Open menu"
      >
        <svg
          viewBox="0 0 20 20"
          class="h-5 w-5"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M3 6h14M3 10h14M3 14h14" class="group-open:hidden" />
          <path d="M5 5l10 10M15 5L5 15" class="hidden group-open:block" />
        </svg>
      </summary>

      <div
        class="absolute right-0 top-13 w-56 rounded-2xl border border-foam/12 bg-panel p-2 shadow-2xl shadow-black/50"
      >
        {
          NAV.map((item) => (
            <a
              href={item.href}
              class="block rounded-xl px-3.5 py-2.5 text-sm text-mist transition-colors hover:bg-foam/6 hover:text-foam"
            >
              {item.label}
            </a>
          ))
        }
        {
          APP.appStoreUrl && (
            <>
              <div class="my-1.5 border-t rule"></div>
              <a
                href={APP.appStoreUrl}
                class="block rounded-xl bg-teal px-3.5 py-2.5 text-center text-sm font-semibold text-abyss"
              >
                Get SoMi
              </a>
            </>
          )
        }
      </div>
    </details>
  </nav>
</header>
