---
/**
 * Surface level. Light, airy, a soft cyan wash behind the type — then the
 * São Miguel clip as a plate, sunk into the page with a depth reading beneath.
 */
---

<section class="hero">
  <div class="glow" aria-hidden="true"></div>

  <div class="wrap">
    <p class="label label--ink kicker">— atlantic / 38° north</p>

    <h1 class="display headline">
      a studio for<br />slow tech, <span class="sub">sound</span>,<br />and story.
    </h1>

    <div class="plate">
      <video
        id="hero-video"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        class="plate-video"
        aria-label="Aerial footage of Ilhéu de Vila Franca, São Miguel, Azores"
      >
        <source src="/azores_clip_noaudio.mp4" type="video/mp4" />
        <source src="/azores_clip.mp4" type="video/mp4" />
      </video>
      <div class="plate-tint" aria-hidden="true"></div>
    </div>

    <div class="caption">
      <span class="num">fig. 01 — ilhéu de vila franca do campo</span>
      <span class="num">são miguel, açores</span>
      <span class="num sounding">sounding <b>−1 240 m</b></span>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: 3.5rem 0 0;
    isolation: isolate;
  }

  /* The one atmospheric flourish on the light half of the site. */
  .glow {
    position: absolute;
    inset: -8rem 0 auto 0;
    height: 34rem;
    z-index: -1;
    background:
      radial-gradient(46rem 24rem at 18% 22%, rgba(0, 180, 216, 0.22), transparent 68%),
      radial-gradient(38rem 22rem at 78% 6%, rgba(144, 224, 239, 0.34), transparent 66%);
    pointer-events: none;
  }

  .kicker {
    display: block;
    margin-bottom: 1rem;
  }

  .headline {
    margin-bottom: 2.25rem;
  }

  .plate {
    position: relative;
    border: 1px solid var(--rule-strong);
    overflow: hidden;
    background: var(--abyss);
    /* The clip has titling burned into its lower third — crop past it. */
    aspect-ratio: 16 / 7;
  }

  .plate-video {
    width: 100%;
    height: 128%;
    object-fit: cover;
    object-position: center top;
    filter: saturate(1.12) contrast(1.04);
  }

  /* Just enough of the palette at the edges to seat the footage in the page —
     a corner vignette, not a wash over the whole frame. */
  .plate-tint {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(70% 60% at 0% 100%, rgba(3, 4, 94, 0.4), transparent 62%),
      radial-gradient(60% 55% at 100% 0%, rgba(0, 180, 216, 0.18), transparent 60%);
    pointer-events: none;
  }

  .caption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.4rem 1.5rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--rule);
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-45);
  }

  .sounding b {
    color: var(--mid);
    font-weight: 600;
  }

  @media (max-width: 700px) {
    .plate {
      aspect-ratio: 4 / 5;
    }
  }
</style>

<script>
  // Safari occasionally ignores the autoplay attribute after a bfcache restore.
  const video = document.getElementById('hero-video') as HTMLVideoElement | null
  video?.play().catch(() => {
    /* autoplay blocked — the still frame is fine */
  })
</script>
