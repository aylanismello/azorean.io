---
/**
 * A slim bar rather than a catalogue index: wordmark, inline links, and the
 * bathymetric depth strip underneath standing in for a border.
 *
 * No JavaScript — the small-screen disclosure is a native <details>.
 */
const links = [
  { label: 'studios', href: '/studios' },
  { label: 'somi', href: '/somi' },
  { label: 'segundo sol', href: '/segundo-sol' },
  { label: 'sound', href: '/sound' },
  { label: 'contact', href: '/contact' },
]

const path = Astro.url.pathname
const isActive = (href: string) => path === href || path.startsWith(`${href}/`)
---

<header class="masthead">
  <div class="wrap bar">
    <a href="/" class="brand" aria-label="Azorean Studios — home">
      <span class="brand-name">azorean</span>
      <span class="brand-sub">studios</span>
    </a>

    <nav class="links" aria-label="Primary">
      {
        links.map((l) => (
          <a href={l.href} class:list={['nav-link', { on: isActive(l.href) }]}>
            {l.label}
          </a>
        ))
      }
    </nav>

    <span class="coords num">38.38° n / 25.44° w</span>

    <details class="mobile">
      <summary aria-label="Menu"><span class="bars" aria-hidden="true"></span></summary>
      <ul>
        {
          links.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))
        }
      </ul>
    </details>
  </div>

  <div class="depth-strip" aria-hidden="true">
    <span></span><span></span><span></span><span></span><span></span>
    <span></span><span></span><span></span><span></span>
  </div>
</header>

<style>
  .masthead {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(246, 251, 253, 0.88);
    backdrop-filter: blur(14px);
  }

  .bar {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 2rem;
    padding-top: 1.15rem;
    padding-bottom: 1.15rem;
  }

  .brand {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    flex-shrink: 0;
  }

  .brand-name {
    font-size: 1.28rem;
    font-weight: 500;
    letter-spacing: -0.045em;
  }

  .brand-sub {
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--mid);
  }

  .links {
    display: flex;
    gap: 1.9rem;
  }

  .nav-link {
    position: relative;
    font-size: 0.95rem;
    letter-spacing: -0.02em;
    color: var(--ink-70);
    padding-bottom: 2px;
    transition: color 0.15s;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 2px;
    background: var(--bright);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.22s ease;
  }

  .nav-link:hover {
    color: var(--ink);
  }

  .nav-link:hover::after,
  .nav-link.on::after {
    transform: scaleX(1);
  }

  .nav-link.on {
    color: var(--ink);
  }

  .coords {
    font-size: 0.64rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-45);
    flex-shrink: 0;
  }

  /* ── Small screens ─────────────────────────────────────────────────── */

  .mobile {
    display: none;
  }

  @media (max-width: 860px) {
    .links,
    .coords {
      display: none;
    }

    .bar {
      align-items: center;
    }

    .mobile {
      display: block;
      position: relative;
    }

    .mobile summary {
      list-style: none;
      cursor: pointer;
      width: 34px;
      height: 34px;
      display: grid;
      place-items: center;
      border: 1px solid var(--rule-strong);
    }

    .mobile summary::-webkit-details-marker {
      display: none;
    }

    .bars,
    .bars::before,
    .bars::after {
      display: block;
      width: 16px;
      height: 1.5px;
      background: var(--ink);
    }

    .bars::before,
    .bars::after {
      content: '';
      position: relative;
    }

    .bars::before {
      top: -5px;
    }

    .bars::after {
      top: 3.5px;
    }

    .mobile[open] .bars {
      background: transparent;
    }

    .mobile[open] .bars::before {
      top: 0;
      transform: rotate(45deg);
    }

    .mobile[open] .bars::after {
      top: -1.5px;
      transform: rotate(-45deg);
    }

    .mobile ul {
      position: absolute;
      right: 0;
      top: calc(100% + 0.75rem);
      z-index: 50;
      list-style: none;
      background: var(--paper);
      border: 1px solid var(--rule-strong);
      min-width: 12rem;
    }

    .mobile li + li {
      border-top: 1px solid var(--rule);
    }

    .mobile a {
      display: block;
      padding: 0.7rem 1rem;
      font-size: 0.95rem;
      letter-spacing: -0.02em;
    }

    .mobile a:hover {
      background: var(--deep);
      color: var(--shell);
    }
  }
</style>
